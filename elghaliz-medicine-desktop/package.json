{
  "name": "elghaliz-medicine-desktop",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.28.5",
  "type": "module",
  "description": "Elghaliz Medicine - Windows desktop client (React + Electron)",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "serve": "node server.mjs",
    "test:drm": "node scripts/verify-drm.mjs",
    "app": "electron .",
    "dist": "vite build && electron-builder --win --dir",
    "dist:installer": "vite build && electron-builder --win",
    "ios:sync": "pnpm build && cap sync ios",
    "ios:open": "cap open ios",
    "cap": "cap"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.3",
    "@capacitor/ios": "^7.4.3",
    "firebase": "^13.2.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "vite": "^5.4.9"
  },
  "build": {
    "appId": "com.elghaliz.medicine",
    "productName": "Elghaliz Medicine",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "electronDist": "electron-dist",
    "win": {
      "target": [
        "dir"
      ],
      "signAndEditExecutable": false
    }
  }
}
